# Copy this file to .env for local development (VS Code) and fill in real values.
# On Vercel, don't upload a .env file — set these same names under
# Project Settings -> Environment Variables instead.

# --- Database (PostgreSQL) ---
# Local dev: point this at a Postgres instance running on your machine, e.g.
#   postgresql://postgres:postgres@localhost:5432/pharma_billing
#
# Vercel/production: use your provider's POOLED connection string, not the direct one —
# this app opens a small connection pool per warm serverless instance, and only a pooled
# connection string (PgBouncer under the hood) keeps that safe under concurrent cold starts.
#   Neon:            use the connection string with "-pooler" in the hostname
#   Vercel Postgres:  the default connection string Vercel gives you is already pooled
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pharma_billing

PORT=8080

# --- Admin login (protects every /api/* endpoint via HTTP Basic Auth) ---
# CHANGE THESE before deploying anywhere public. See README.md / DEPLOYMENT-VERCEL.md for
# why the frontend PAGES themselves aren't covered by this on Vercel specifically.
APP_SECURITY_USERNAME=admin
APP_SECURITY_PASSWORD=changeme

# Set to "true" to seed one demo party + two demo products on first run (useful for
# trying the app out). Leave "false" for the real business data only.
DEMO_DATA_ENABLED=false

# --- Email Bill (optional — leave blank to disable; POST /api/sales-invoices/:id/email
# will return a clear error instead of failing silently) ---
# For Gmail: create an "App Password" (not your normal password) at
# https://myaccount.google.com/apppasswords and use that as SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM_NAME=Vivaan Pharmacy
